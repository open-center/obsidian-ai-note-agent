{
	"name": "ai-note-agent",
	"version": "1.1.0",
	"description": "Chat with OpenAI, Claude, DeepSeek or any OpenAI-compatible model in Obsidian and let it read, search and edit your notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"ai",
		"agent",
		"openai",
		"claude",
		"llm"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"author": "zhang33 <zyb@zhang33.net>",
	"repository": {
		"type": "git",
		"url": "https://github.com/open-center/obsidian-ai-note-agent.git"
	}
}